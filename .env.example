# Application runtime. ADMIN_PASSWORD must be 12-200 characters when set.
INSTANCE_ID=default
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Extra immediate reverse-proxy IP addresses/CIDRs for a direct runtime.
# Loopback is always trusted. Compose derives this from APP_NETWORK_GATEWAY.
HTTP_TRUSTED_PROXIES=
LOG_LEVEL=info
DATABASE_PATH=./data/inbox-point.sqlite
CLOSED_REQUEST_RETENTION_DAYS=7
ADMIN_PASSWORD=

# Set ENABLED=true only when the complete server-managed channel config is set.
# Leave false to connect and manage that channel through the protected UI.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Optional HTTP(S) CONNECT proxy used only for Telegram Bot API requests.
TELEGRAM_PROXY_URL=
VK_ENABLED=false
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_POLL_TIMEOUT_SECONDS=25

# Compose publishes the app on loopback only. Keep backup storage outside data.
HOST_PORT=3101
# Use a unique, unused private subnet and gateway for every instance on a host.
APP_NETWORK_SUBNET=172.30.1.0/24
APP_NETWORK_GATEWAY=172.30.1.1
BACKUP_HOST_PATH=./external-backups
# Used by `npm run backup:create`; Compose maps BACKUP_HOST_PATH to /backup.
BACKUP_EXPORT_PATH=./external-backups
BACKUP_ALERT_WEBHOOK_URL=https://alerts.example.com/inbox-point-backup
BACKUP_ALERT_BEARER_TOKEN=
BACKUP_TIMEOUT_SECONDS=10
