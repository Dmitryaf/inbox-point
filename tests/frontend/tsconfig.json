{
  "extends": "../../frontend/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../../src/*"],
      "@core/*": ["../../src/core/*"],
      "@frontend/*": ["../../frontend/src/*"],
      "@frontend-common/*": ["../../frontend/common/*"],
      "@test/*": ["../*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "../../frontend/src/**/*.d.ts", "**/*.tsx"]
}
