[Unit]
Description=Messenger Handoff Telegram HTTP CONNECT egress proxy
Requires=wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tinyproxy -d -c /etc/tinyproxy/messenger-handoff.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
