[Unit]
Description=Inbox Point independent availability monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inbox-point-monitor
Group=inbox-point-monitor
WorkingDirectory=/opt/inbox-point-monitor
EnvironmentFile=/etc/inbox-point/monitor.env
ExecStart=/usr/bin/java -jar inbox-point.jar availability-monitor
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
