{
  "name": "inbox-point",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.20.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:frontend:react": "vite build --config frontend/vite.config.ts --mode react",
    "build:server": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js",
    "backup:create": "node --env-file-if-exists=.env dist/create-external-backup.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:deploy && npm run build",
    "check:e2e": "npm run build:frontend && playwright test",
    "check:react": "npm run typecheck:react && npm run test:react && npm run build:frontend:react",
    "check:react:e2e": "npm run build:frontend:react && playwright test --config playwright.react.config.ts",
    "dev": "npm run build:frontend && tsx watch --env-file-if-exists=.env src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "snapshot:create": "node --env-file-if-exists=.env dist/create-service-snapshot.js",
    "snapshot:restore": "node dist/restore-service-snapshot.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:availability-monitor": "node --env-file-if-exists=.env.monitor dist/availability-monitor.js",
    "test": "vitest run",
    "test:react": "vitest run --config vitest.react.config.ts",
    "test:deploy": "node tests/deploy/run-update-instance-tests.mjs",
    "test:e2e:server": "tsx tests/e2e/support/server.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:frontend && npm run typecheck:frontend-tests",
    "typecheck:frontend": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "typecheck:frontend-tests": "vue-tsc --noEmit -p tests/frontend/tsconfig.json",
    "typecheck:react": "tsc --noEmit -p frontend/react/tsconfig.json && tsc --noEmit -p tests/react/tsconfig.json",
    "typecheck:server": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "fastify": "^5.12.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "undici": "^8.10.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
