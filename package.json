{
  "name": "inbox-point",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.20.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:server": "node scripts/run-java.mjs build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:deploy && npm run build",
    "dev": "npm run build && npm run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "backup:create": "node --env-file-if-exists=.env scripts/run-java.mjs backup-create",
    "snapshot:create": "node --env-file-if-exists=.env scripts/run-java.mjs snapshot-create",
    "snapshot:restore": "node scripts/run-java.mjs snapshot-restore",
    "start": "node --env-file-if-exists=.env scripts/run-java.mjs start",
    "test": "vitest run",
    "test:deploy": "node tests/deploy/run-update-instance-tests.mjs",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:frontend-tests",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "typecheck:frontend-tests": "tsc --noEmit -p tests/frontend/tsconfig.json",
    "start:availability-monitor": "node scripts/run-java.mjs availability-monitor",
    "check:e2e": "npm run build && playwright test",
    "test:e2e:server": "node tests/e2e/support/java-server.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.5.4",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@playwright/test": "^1.63.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
