{
  "name": "messenger-handoff",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.20.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json -f -fe .js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "npm run build:frontend && tsx watch --env-file-if-exists=.env src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "snapshot:create": "node --env-file-if-exists=.env dist/create-service-snapshot.js",
    "snapshot:restore": "node dist/restore-service-snapshot.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:availability-monitor": "node --env-file-if-exists=.env.monitor dist/availability-monitor.js",
    "test": "vitest run",
    "typecheck": "npm run typecheck:server && npm run typecheck:frontend && npm run typecheck:frontend-tests",
    "typecheck:frontend": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "typecheck:frontend-tests": "vue-tsc --noEmit -p tests/frontend/tsconfig.json",
    "typecheck:server": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.3",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
